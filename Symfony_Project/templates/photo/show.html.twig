{% extends 'base.html.twig' %}

{% block title %}Photo{% endblock %}

{% block body %}
    <h1 class="mb-4">Photo</h1>

    <table class="table table-striped table-hover align-middle">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ photo.id }}</td>
            </tr>
            <tr>
                <th>Prise de vue</th>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Fichier</th>
                <td>{{ photo.nomFichier }}</td>
            </tr>
            <tr>
                <th>État de l’œuvre</th>
                <td>{{ photo.etatOeuvre }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_photo_index') }}">Retour à la liste</a>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>

    {{ include('photo/_delete_form.html.twig') }}
{% endblock %}
