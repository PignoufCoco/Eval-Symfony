{% extends 'base.html.twig' %}

{% block title %}Photos{% endblock %}

{% block body %}
    <h1 class="mb-4">Photos</h1>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Prise de vue</th>
                <th>Photo</th>
                <th>État de l’œuvre</th>
                <th>Œuvre</th>
                <th>Bénévole</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for photo in photos %}
            <tr>
                <td>{{ photo.id }}</td>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" alt="{{ photo.oeuvre.titre }}" class="img-thumbnail" style="width: 120px; height: 90px; object-fit: cover;" loading="lazy">
                </td>
                <td>{{ photo.etatOeuvre }}</td>
                <td>{{ photo.oeuvre.titre }}</td>
                <td>{{ photo.benevole.prenom }} {{ photo.benevole.nom }}</td>
                <td>
                    <a class="btn btn-outline-primary mb-2" href="{{ path('app_photo_show', {'id': photo.id}) }}">Voir</a>
                    <a class="btn btn-outline-primary mb-2" href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun résultat.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_photo_new') }}">Ajouter</a>
{% endblock %}
