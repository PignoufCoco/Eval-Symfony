{% extends 'base.html.twig' %}

{% block title %}Techniques{% endblock %}

{% block body %}
    <h1 class="mb-4">Techniques</h1>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.id }}</td>
                <td>{{ technique.nom }}</td>
                <td>
                    <a class="btn btn-outline-primary mb-2" href="{{ path('app_technique_show', {'id': technique.id}) }}">Voir</a>
                    <a class="btn btn-outline-primary mb-2" href="{{ path('app_technique_edit', {'id': technique.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun résultat.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_technique_new') }}">Ajouter</a>
{% endblock %}
