{% extends 'base.html.twig' %}

{% block title %}Artiste{% endblock %}

{% block body %}
    <h1 class="mb-4">Artiste</h1>

    <table class="table table-striped align-middle">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Pseudonyme</th>
                <td>{{ artiste.pseudonyme }}</td>
            </tr>
            <tr>
                <th>NomReel</th>
                <td>{{ artiste.nomReel }}</td>
            </tr>
            <tr>
                <th>Bio</th>
                <td>{{ artiste.bio }}</td>
            </tr>
            <tr>
                <th>Nationalite</th>
                <td>{{ artiste.nationalite }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-secondary" href="{{ path('app_artiste_index') }}">back to list</a>

    <a class="btn btn-warning" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">edit</a>

    {{ include('artiste/_delete_form.html.twig') }}
{% endblock %}
