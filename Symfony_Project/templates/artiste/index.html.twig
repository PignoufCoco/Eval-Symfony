{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1 class="mb-4">Artistes</h1>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>Nom réel</th>
                <th>Bio</th>
                <th>Nationalité</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td class="text-nowrap">
                    <a class="btn btn-info" href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                    <a class="btn btn-warning" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun résultat.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_artiste_new') }}">Ajouter</a>
{% endblock %}
