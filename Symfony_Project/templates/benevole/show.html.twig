{% extends 'base.html.twig' %}

{% block title %}Benevole{% endblock %}

{% block body %}
    <h1 class="mb-4">Benevole</h1>

    <table class="table table-striped table-hover align-middle">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ benevole.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ benevole.nom }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ benevole.prenom }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ benevole.email }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_benevole_index') }}">Retour à la liste</a>

    <a class="btn btn-outline-primary mb-2" href="{{ path('app_benevole_edit', {'id': benevole.id}) }}">Modifier</a>

    {{ include('benevole/_delete_form.html.twig') }}
{% endblock %}
